# ─── DocuSign (no activado todavía) ──────────────────────────────────────
# Para activar: instalar `docusign-esign`, rellenar estas variables y
# completar la implementación en backend/src/services/docusign.service.js
# Demo durante desarrollo:
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=account-d.docusign.com
# En producción cambiar a:
#   DOCUSIGN_BASE_URL=https://www.docusign.net/restapi
#   DOCUSIGN_OAUTH_BASE_URL=account.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=./docusign-private.key
DOCUSIGN_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
