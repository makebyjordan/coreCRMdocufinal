// ─── REPORTING ─────────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(cuid())
  name         String
  type         ReportType
  format       ReportFormat
  createdById  String
  generatedAt  DateTime     @default(now())
  fileUrl      String?      // S3 path o local path
  fileSize     Int?         // en bytes
  filters      Json?        // filtros aplicados al generar el reporte
  description  String?
  isScheduled  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?    // para limpiar reportes antiguos

  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([type])
  @@index([createdAt])
  @@map("reports")
}

model Commission {
  id             String   @id @default(cuid())
  expedientId    String
  userId         String   // comercial
  amount         Decimal  @db.Decimal(12, 2)
  percentage     Decimal  @db.Decimal(5, 2)
  calculatedAt   DateTime @default(now())
  invoiced       Boolean  @default(false)
  invoicedAt     DateTime?
  paid           Boolean  @default(false)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expedient      Expedient  @relation(fields: [expedientId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expedientId])
  @@index([userId])
  @@index([createdAt])
  @@map("commissions")
}

// ─── BÚSQUEDA ──────────────────────────────────────────────────────────────────

model SavedSearch {
  id           String   @id @default(cuid())
  userId       String
  name         String
  filters      Json     // { search, operationType, status, phase, etc }
  searchText   String?  // para full-text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("saved_searches")
}

model SearchIndex {
  id           String   @id @default(cuid())
  expedientId  String?
  clientId     String?
  searchText   String   @db.Text // concatenado: address, cliente, notas, tags
  indexed      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expedient    Expedient?  @relation(fields: [expedientId], references: [id], onDelete: Cascade)
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([searchText])
  @@index([expedientId])
  @@index([clientId])
  @@map("search_indexes")
}

// ─── CHAT & COLABORACIÓN ───────────────────────────────────────────────────────

model ChatThread {
  id             String   @id @default(cuid())
  expedientId    String?
  clientId       String?
  subject        String
  isDirect       Boolean  @default(false)
  createdById    String
  lastMessageAt  DateTime?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expedient      Expedient?      @relation(fields: [expedientId], references: [id], onDelete: SetNull)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  participants   ChatParticipant[]

  @@index([expedientId])
  @@index([createdAt])
  @@map("chat_threads")
}

model ChatMessage {
  id             String   @id @default(cuid())
  threadId       String
  userId         String
  content        String   @db.Text
  mentions       String[] @default([]) // userIds mencionados
  attachments    Json?    // { filename, path, mimeType }
  edited         Boolean  @default(false)
  editedAt       DateTime?
  createdAt      DateTime @default(now())

  thread         ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatParticipant {
  id             String   @id @default(cuid())
  threadId       String
  userId         String
  unreadCount    Int      @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime @default(now())

  thread         ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("chat_participants")
}

model DetailedActivityLog {
  id             String   @id @default(cuid())
  expedientId    String?
  clientId       String?
  userId         String
  entityType     String   // Expedient, Document, Signature, Task, etc
  entityId       String
  action         AuditAction
  fieldChanged   String?  // para UPDATED
  oldValue       String?  // para UPDATED
  newValue       String?  // para UPDATED
  description    String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  timestamp      DateTime @default(now())

  expedient      Expedient? @relation(fields: [expedientId], references: [id], onDelete: SetNull)
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expedientId])
  @@index([clientId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("detailed_activity_logs")
}

// ─── GESTIÓN DE CLIENTES ───────────────────────────────────────────────────────

model ClientSegment {
  id             String   @id @default(cuid())
  clientId       String   @unique
  segment        ClientSegmentStatus
  score          Decimal  @db.Decimal(5, 2) // 0-100
  valueEstimate  Decimal? @db.Decimal(15, 2) // ingresos potenciales
  lastCalculated DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([segment])
  @@map("client_segments")
}

model ClientReferral {
  id                String   @id @default(cuid())
  referrerClientId  String
  referredClientId  String
  notes             String?
  closedExpedients  Int      @default(0) // contador de expedientes cerrados
  value             Decimal? @db.Decimal(15, 2) // valor total comisiones de referidos
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  referrerClient    Client   @relation("ReferrerClient", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referredClient    Client   @relation("ReferredClient", fields: [referredClientId], references: [id], onDelete: Cascade)

  @@unique([referrerClientId, referredClientId])
  @@map("client_referrals")
}

// Relación existente en Client ampliada
// Necesita actualización en Client model para soportar:
// referredBy         ClientReferral[] @relation("ReferrerClient")
// referredClients    ClientReferral[] @relation("ReferredClient")

// ─── SEGURIDAD & AUDITORÍA ────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  userId         String
  action         AuditAction
  resourceType   String   // Expedient, Client, Document, User, etc
  resourceId     String
  changes        Json?    // { fieldName: { old: value, new: value } }
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType])
  @@index([timestamp])
  @@map("audit_logs")
}

model DocumentEncryption {
  id             String   @id @default(cuid())
  documentId     String   @unique
  encryptedAt    DateTime @default(now())
  accessList     String[] @default([]) // userIds que pueden desencriptar
  metadata       Json?    // { algorithm: "AES-256", version: 1 }

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_encryptions")
}

model BackupLog {
  id             String   @id @default(cuid())
  type           String   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  status         String   @default("PENDING") // PENDING, COMPLETED, FAILED
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  fileSize       BigInt?  // en bytes
  s3Path         String?
  errorMessage   String?
  retentionDays  Int      @default(30)

  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@map("backup_logs")
}

model UserSession {
  id             String   @id @default(cuid())
  userId         String
  token          String   // JWT hash o session ID
  status         UserSessionStatus @default(ACTIVE)
  loginAt        DateTime @default(now())
  lastActivityAt DateTime @updatedAt
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  metadata       Json?    // { browser, os, device }

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ─── PRODUCTIVIDAD ────────────────────────────────────────────────────────────

model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  shortcuts      Json?    // { "ctrl+e": "CREATE_EXPEDIENT", "ctrl+shift+s": "SEARCH" }
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?  // TOTP secret (encrypted)
  mfaMethod      String   @default("TOTP") // TOTP, SMS
  notificationPreferences Json? // { email: true, inApp: true, sms: false }
  defaultFilters Json?    // filtros que aplica automáticamente
  theme          String   @default("LIGHT") // LIGHT, DARK
  timezone       String   @default("Europe/Madrid")
  language       String   @default("es")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model BulkAction {
  id             String   @id @default(cuid())
  userId         String
  type           BulkActionType
  status         BulkActionStatus @default(PENDING)
  expedientIds   String[] // array de IDs a actualizar
  parameters     Json     // { phase: "ACUERDO", assignedTo: "userId", tags: ["urgente"] }
  totalCount     Int      @default(0)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  errorLog       String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("bulk_actions")
}

// ─── DATOS & INTELIGENCIA ──────────────────────────────────────────────────────

model PropertyMarketData {
  id             String   @id @default(cuid())
  city           String
  zone           String
  propertyType   String   // RESIDENTIAL, COMMERCIAL, INDUSTRIAL
  avgPrice       Decimal  @db.Decimal(15, 2)
  avgPricePerSqm Decimal  @db.Decimal(10, 2)
  trendPercentage Decimal @db.Decimal(5, 2) // month-over-month
  saleCount      Int      @default(0)
  rentalCount    Int      @default(0)
  lastUpdated    DateTime @default(now())
  source         String?  // idealist, portal, internal
  dataDate       DateTime // fecha a la que corresponden los datos

  @@unique([city, zone, propertyType])
  @@index([city])
  @@index([lastUpdated])
  @@map("property_market_data")
}

// ─── AI/ML (Phase 2) ───────────────────────────────────────────────────────────

model ClientPrediction {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  annualValueForecast   Decimal  @db.Decimal(12, 2)
  closureProbability    Int      // 0-100
  recommendations       String[] // JSON array
  riskFactors          String[] // JSON array
  recommendedSegment   String   // VIP, NORMAL, RIESGO
  generatedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_predictions")
}

model DormantClientAnalysis {
  id                  String   @id @default(cuid())
  clientId            String
  inactiveDays        Int
  reactivationReason  String
  reactivationPriority Int      // 1-10
  reactivationStrategy String
  reactivationMessage String?
  immediateActions    String[] // JSON array
  analyzedAt          DateTime @default(now())

  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("dormant_client_analyses")
}

model ExpedientRecommendation {
  id                  String   @id @default(cuid())
  expedientId         String   @unique
  immediateActions    String[] // JSON array
  risks               String[] // JSON array
  optimizations       String[] // JSON array
  estimatedDaysToClose Int
  healthScore         Int      // 0-100
  generatedAt         DateTime @default(now())

  expedient           Expedient @relation(fields: [expedientId], references: [id], onDelete: Cascade)

  @@map("expedient_recommendations")
}

model DocumentAnalysis {
  id                  String   @id @default(cuid())
  documentId          String   @unique
  detectedType        String
  extractedData       Json     // JSON de datos extraídos
  completeness        Int      // 0-100
  alerts              String[] // JSON array
  recommendedAction   String
  confidence          Int      // 0-100
  analyzedAt          DateTime @default(now())

  document            Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_analyses")
}

model AITemplate {
  id                  String   @id @default(cuid())
  expedientId         String
  templateType        String   // CONTRATO, OFERTA, PROPUESTA, etc
  title               String
  content             String   // HTML
  variables           String[] // Lista de variables
  description         String?
  generatedAt         DateTime @default(now())

  expedient           Expedient @relation(fields: [expedientId], references: [id], onDelete: Cascade)

  @@map("ai_templates")
}

// ─── MOBILE (Pospuesto Fase 2) ─────────────────────────────────────────────────

model DeviceRegistration {
  id             String   @id @default(cuid())
  userId         String
  deviceToken    String   // FCM o APNS token
  platform       PlatformType
  deviceName     String?  // iPhone 12, Samsung Galaxy, etc
  appVersion     String?
  osVersion      String?
  registeredAt   DateTime @default(now())
  lastUsedAt     DateTime?
  isActive       Boolean  @default(true)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceToken])
  @@index([userId])
  @@map("device_registrations")
}

// ─── ROLES Y COLABORADORES ─────────────────────────────────────────────────────

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  assignedAt DateTime @default(now())
  assignedBy String?  // ID del usuario que asignó el rol

  user      User     @relation("userRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_role_assignments")
}

model ExpedientCollaborator {
  id              String              @id @default(cuid())
  expedientId     String
  userId          String
  collaboratorRole CollaboratorRole   // ASIGNADO, CO_RESPONSABLE, REVISOR, OBSERVADOR
  addedAt         DateTime            @default(now())
  addedBy         String?             // ID del usuario que añadió el colaborador
  notes           String?             // Notas sobre el rol del colaborador

  expedient       Expedient           @relation(fields: [expedientId], references: [id], onDelete: Cascade)
  user            User                @relation("expedientCollaborations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expedientId, userId])
  @@index([expedientId])
  @@index([userId])
  @@map("expedient_collaborators")
}

